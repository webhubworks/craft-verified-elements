{% import "_includes/forms" as forms %}

<fieldset>
    <legend class="h6 status-label">
        <span class="mb-[1px]">{{ 'Verification'|t(pluginHandle) }}</span>
        {% if isVerified %}
            <span data-icon="circle-check" class="cp-icon puny"></span>
        {% endif %}
    </legend>

    <div class="meta">
        {{ forms.selectizeField({
            label:
                (not isVerified ? '<span data-icon="alert"></span>') ~ 'Verified until'|t(pluginHandle),
            id: 'verifiedUntilDate',
            name: 'verifiedUntilDate',
            options: options,
            selectizeOptions: {
                allowEmptyOption: false,
                autocomplete: false,
            },
            includeEnvVars: false,
            value: verifiedUntilDate ? verifiedUntilDate|date('Y-m-d') : false,
            addOptionLabel: 'Specific Date'|t(pluginHandle),
            addOptionFn: addOptionFn,
        }) }}

        {{ forms.elementSelectField({
            label: 'Reviewer'|t(pluginHandle),
            id: 'reviewerId',
            name: 'reviewerId',
            elementType: 'craft\\elements\\User',
            single: true,
            selectionLabel: 'Choose'|t('app'),
            elements: reviewer ? [reviewer] : [],
            criteria: {
                status: 'active',
                can: 'verified-entries:verifyEntries',
            }
        }) }}
    </div>
</fieldset>
