{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') -%}

{% do view.registerTranslations('app', [
    'Name',
    'Section',
    'Volume',
    'Date Updated',
]) %}

{% set isMultiSite = craft.app.sites.allSites|filter(s => s.enabled)|length > 1 %}
{% set isEntriesTab = selectedElementType == 'entries' %}

{% set tabs = {} %}
{% if showEntriesTab %}
    {% set tabs = tabs|merge({
        entries: {
            label: 'Entries'|t('app'),
            url: url(craft.app.request.pathInfo, {elementType: 'entries'}),
        },
    }) %}
{% endif %}
{% if showAssetsTab %}
    {% set tabs = tabs|merge({
        assets: {
            label: 'Assets'|t('app'),
            url: url(craft.app.request.pathInfo, {elementType: 'assets'}),
        },
    }) %}
{% endif %}

{% if tabs|length > 1 %}
    {% include '_includes/tabs' with {
        tabs: tabs,
        selectedTab: selectedElementType,
    } only %}

    {# The content pane's default 24px top padding pushes the tabs down; let them sit flush
       against the pane's top edge. Registered here, this only applies to this screen. #}
    {% css %}
        #content.content-pane {
            padding-top: 0;
            padding-bottom: 0;
        }
    {% endcss %}
{% endif %}

{# The negative side margins counteract the content pane's 24px padding - the same trick
   Craft's own .pane-tabs uses - so the table stretches to the pane's edges. #}
<div class="tableview" style="overflow-x: auto; overflow-y: hidden; margin: 18px -18px 0;">
    <div id="elements-vue-admin-table"></div>
</div>

{% if isEntriesTab %}
    {% set emptyMessage = 'There are currently no entries assigned to you.'|t(pluginHandle) %}
    {% set containerColumnTitle = 'Section' %}
{% else %}
    {% set emptyMessage = 'There are currently no assets assigned to you.'|t(pluginHandle) %}
    {% set containerColumnTitle = 'Volume' %}
{% endif %}

{% js %}
    (() => {
        const columns = [
            {
                name: 'isVerified',
                title: '',
                sortField: true,
                callback: function(value) {
                const color = value === 'Verified' ? 'var(--teal-500)' : 'var(--red-500)';
                return '<span title="' + value + '" style="display:flex;align-items:center;justify-content:center;">' +
                    '<span style="width:10px;height:10px;border-radius:50%;flex-shrink:0;background:' + color + ';"></span>' +
                    '</span>';
                }
            },
            { name: '__slot:title', title: Craft.t('app', 'Name'), sortField: true },
            {% if isMultiSite %}
                { name: 'siteName', title: 'Site', sortField: true },
            {% endif %}
            { name: 'containerName', title: Craft.t('app', '{{ containerColumnTitle }}'), sortField: true },
            { name: 'verifiedUntilDate', title: 'Verified until', sortField: true },
            { name: 'dateUpdated', title: Craft.t('app', 'Date Updated'), sortField: true },
        ];

        let config = {
            columns,
            container: '#elements-vue-admin-table',
            emptyMessage: '{{ emptyMessage }}',
            tableDataEndpoint: 'verified-elements/index/table-data?userId={{ userId }}&elementType={{ selectedElementType }}',
            fullPane: false,
        };

        new Craft.VueAdminTable(config);
    })();
{% endjs %}
