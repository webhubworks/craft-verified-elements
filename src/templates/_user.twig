{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') -%}

{% do view.registerTranslations('app', [
    'Name',
    'Section',
    'Date Updated',
]) %}

{% set isMultiSite = craft.app.sites.allSites|filter(s => s.enabled)|length > 1 %}

<h2>{{ 'Sections'|t('app') }}</h2>

{% if sections|length %}
    <p>{{ "You're the default reviewer for entries in these sections"|t(pluginHandle) }}:</p>
    <table id="sections" class="data fullwidth">
        <thead>
        <th scope="col">{{ 'Name'|t('app') }}</th>
        {% if isMultiSite %}<th scope="col">{{ 'Site'|t('app') }}</th>{% endif %}
        <th scope="col">{{ 'Default Period'|t(pluginHandle) }}</th>
        </thead>
        <tbody>
        {% for section in sections %}
            <tr>
                <th scope="row" data-title="{{ 'Name'|t('app') }}">
                    <a href="{{ cpUrl('entries/' ~ section.handle) }}">{{ section.name }}</a>
                </th>
                {% if isMultiSite %}<td>{{ section.siteName }}</td>{% endif %}
                <td>
                    {{ section.defaultPeriod }}
                </td>
            </tr>

        {% endfor %}
        </tbody>
    </table>
{% else %}
    <div class="zilch">
        <p>{{ 'No sections are available.'|t('app') }}</p>
    </div>
{% endif %}
<hr />

<h2>{{ 'Assigned Entries'|t(pluginHandle) }}</h2>
<div class="tableview" style="overflow-x: auto; overflow-y: hidden; ">
    <div id="entries-vue-admin-table"></div>
</div>

{% set emptyMessage = 'There are currently no entries assigned to you.'|t(pluginHandle) %}

{% js %}
    (() => {
        const columns = [
            {
                name: 'isVerified',
                title: '',
                sortField: true,
                callback: function(value) {
                const color = value === 'Verified' ? 'var(--teal-500)' : 'var(--red-500)';
                return '<span title="' + value + '" style="display:flex;align-items:center;justify-content:center;">' +
                    '<span style="width:10px;height:10px;border-radius:50%;flex-shrink:0;background:' + color + ';"></span>' +
                    '</span>';
                }
            },
            { name: '__slot:title', title: Craft.t('app', 'Name'), sortField: true },
            {% if isMultiSite %}
                { name: 'siteName', title: 'Site', sortField: true },
            {% endif %}
            { name: 'sectionName', title: Craft.t('app', 'Section'), sortField: true },
            { name: 'verifiedUntilDate', title: 'Verified until', sortField: true },
            { name: 'dateUpdated', title: Craft.t('app', 'Date Updated'), sortField: true },
        ];

        let config = {
            columns,
            container: '#entries-vue-admin-table',
            emptyMessage: '{{ emptyMessage }}',
            tableDataEndpoint: 'verified-entries/entries/table-data&userId={{ userId }}',
            fullPane: false,
        };

        new Craft.VueAdminTable(config);
    })();
{% endjs %}
