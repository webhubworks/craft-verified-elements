{% set isMultiSite = craft.app.sites.allSites|filter(s => s.enabled)|length > 1 %}
<div class="elementstoreview-container">
    <table class="ve-widget-table fullwidth">
        <thead>
        <tr>
            <th>{{ 'Title'|t('app') }}</th>
            <th>{{ 'Section'|t('app') }}</th>
            {% if isMultiSite %}
                <th>{{ 'Site'|t('app') }}</th>
            {% endif %}
            <th>{{ 'Expires'|t('app') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for element in elements %}
            <tr>
                <td>
                    {{ statusIndicator|raw }}
                    <a href="{{ element.getCpEditUrl() }}">{{ element.title }}</a>
                </td>
                <td>{{ element.section.name }}</td>
                {% if isMultiSite %}
                    <td class="light">{{ element.site.name }}</td>
                {% endif %}
                <td class="light">{{ element.verifiedUntilDate|readableVerificationDate }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
