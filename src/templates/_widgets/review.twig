<div class="entriestoreview-container">
    <table class="ve-widget-table fullwidth">
        <thead>
        <tr>
            <th>{{ 'Title'|t('app') }}</th>
            <th>{{ 'Site'|t('app') }}</th>
            <th>{{ 'Expires'|t('app') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for entry in entries %}
            <tr>
                <td>
                    {{ statusIndicator|raw }}
                    <a href="{{ entry.getCpEditUrl() }}">{{ entry.title }}</a>
                </td>
                <td class="light">{{ entry.site.name }}</td>
                <td class="light">{{ entry.verifiedUntilDate|timestamp('short') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
