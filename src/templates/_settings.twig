{% extends '_layouts/cp.twig' %}

{% set title = 'Settings'|t('app') %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'settings' %}
{% set crumbs = [
    { label: 'Verified Entries'|t(pluginHandle), url: url(pluginHandle) }
] %}

{% if sites|length > 1 %}
    {% set tabs = [] %}
    {% set selectedTab = 0 %}
    {% for site in sites %}
        {% if site.id == currentSite.id %}
            {% set selectedTab = loop.index0 %}
        {% endif %}
        {% set tabs = tabs|merge([{
            label: site.name,
            url: url(pluginHandle ~ '/settings', {site: site.handle}),
        }]) %}
    {% endfor %}
{% endif %}

{% import '_includes/forms.twig' as forms %}

{% set formActions = [
    {
        label: 'Save'|t('app'),
        shortcut: true,
        retainScroll: true,
    },
] %}

{% block content %}
    {{ actionInput(pluginHandle ~ '/settings/save') }}
    {{ redirectInput(pluginHandle ~ '/settings?site=' ~ currentSite.handle) }}
    {{ hiddenInput('siteId', currentSite.id) }}

    <div class="ve-table-wrap">
        <table class="ve-table">
            <thead>
            <tr>
                <th>{{ 'Section'|t('app') }}</th>
                <th>{{ 'Section Type'|t('app') }}</th>
                <th>{{ 'Enabled'|t('app') }}</th>
                <th>{{ 'Default Reviewer'|t(pluginHandle) }}</th>
                <th>{{ 'Default Period'|t(pluginHandle) }}</th>
            </tr>
            </thead>
            <tbody>
            {% for section in sections %}
                {% set ns = 'sections[' ~ section.id ~ ']' %}
                {% namespace ns %}
                    <tr>
                        <th>{{ section.name }}</th>
                        <td>{{ section.type|capitalize|t('app') }}</td>
                        <td>
                            {{ forms.lightswitch({
                                name: 'enabled',
                                on: section.enabled
                            }) }}
                        </td>
                        <td>
                            {% set reviewerSelectField %}
                                {{ forms.elementSelect({
                                    name: 'reviewerId',
                                    elementType: 'craft\\elements\\User',
                                    elements: section.reviewerId ? [section.reviewer] : [],
                                    criteria: {
                                        status: 'active',
                                        can: 'verified-entries:verifyEntries',
                                    },
                                    limit: 1,
                                    hideSidebar: true,
                                }) }}
                            {% endset %}

                            {% if section.enabled and not section.reviewerId %}
                                <div class="flex" style="align-items:center;flex-wrap:nowrap;">
                                    {{ reviewerSelectField }}
                                    <p class="warning" style="margin:0;max-width:400px;">
                                        {{ 'No default reviewer. Expired entries will go unnotified.'|t(pluginHandle) }}
                                    </p>
                                </div>
                            {% else %}
                                {{ reviewerSelectField }}
                            {% endif %}
                        </td>
                        <td>
                            {{ forms.select({
                                name: 'defaultPeriod',
                                options: periodSelectOptions,
                                value: section.defaultPeriod,
                            }) }}
                        </td>
                    </tr>
                {% endnamespace %}
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% css %}
    .ve-table-wrap {
    border: 1px solid rgba(51, 64, 77, 0.15);
    border-radius: 5px;
    overflow: hidden;
    }
    .ve-table {
    width: 100%;
    border-collapse: collapse;
    }
    .ve-table thead tr {
    background: #f7f8f9;
    border-bottom: 1px solid rgba(51, 64, 77, 0.1);
    }
    .ve-table thead th {
    padding: 8px 14px;
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8f98a3;
    }
    .ve-table tbody tr + tr {
    border-top: 1px solid rgba(51, 64, 77, 0.07);
    }
    .ve-table tbody td,
    .ve-table tbody th {
    padding: 10px 14px;
    vertical-align: middle;
    }
{% endcss %}

{% js %}
    Craft.initUiElements();
{% endjs %}
